// Second dev container configuration with access to boards on USB, for
// flashing and monitoring from inside the container ("Dev Containers: Rebuild
// and Reopen in Container" offers it next to the default one). The default
// configuration stays without device access, so it also works in Codespaces.
//
// The host's /dev is bind-mounted, so boards that are plugged in later, or
// that enumerate again after a reset (USB-Serial-JTAG), appear without a
// rebuild. With rootless Docker the container's root is the host user, so the
// host user needs read and write access to the serial devices; see
// .devcontainer/hardware/README.md.
{
  "name": "TrailCamHub ESP-IDF (USB boards)",
  "image": "espressif/idf:v5.5.6",
  "workspaceMount": "source=${localWorkspaceFolder},target=/project,type=bind,consistency=cached",
  "workspaceFolder": "/project",
  "remoteUser": "root",
  "runArgs": ["--privileged"],
  "mounts": ["source=/dev,target=/dev,type=bind"],
  "containerEnv": {
    "IDF_PATH": "/opt/esp/idf"
  },
  "postCreateCommand": "bash -lc 'source \"$IDF_PATH/export.sh\" >/dev/null && idf.py --version && ls -l /dev/serial/by-id 2>/dev/null || echo \"No USB serial devices found\"'"
}
