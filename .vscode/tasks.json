{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF: Build firmware",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source \"$IDF_PATH/export.sh\" >/dev/null && idf.py build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "ESP-IDF: Build release firmware and show size",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source \"$IDF_PATH/export.sh\" >/dev/null && idf.py -B build-release -D IDF_TARGET=esp32s3 -D SDKCONFIG=build-release/sdkconfig -D SDKCONFIG_DEFAULTS='sdkconfig.defaults;sdkconfig.defaults.release' build size"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Host tests",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cmake -S test/host -B build-host -DCMAKE_BUILD_TYPE=Debug && cmake --build build-host --parallel && ctest --test-dir build-host --output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "test"
    },
    {
      "label": "Check C/C++ formatting (as in CI)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "git ls-files '*.c' '*.cpp' '*.h' '*.hpp' | xargs clang-format --dry-run --Werror"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
