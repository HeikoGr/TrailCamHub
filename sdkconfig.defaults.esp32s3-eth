# Board: Waveshare ESP32-S3-ETH (ESP32-S3R8 with 8 MB octal PSRAM, 16 MB flash,
# W5500 Ethernet on SPI, microSD slot, optional PoE module). Build with the
# esp32s3 target and
#   SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3-eth"
# so that these settings override the common and ESP32-S3 defaults.
#
# Tested on a board: boot, SD card, W5500 link and DHCP, web UI over Ethernet,
# on USB power and on PoE alone; SNTP over Ethernet on PoE. NOT tested with a
# camera (no BLE activation, camera Wi-Fi or media download on this board yet).

CONFIG_BOARD_ESP32S3_ETH=y

# Ethernet is the uplink; the camera Wi-Fi is only a local link. Use the DNS
# servers of the default interface so the camera's DHCP server cannot replace
# the Ethernet DNS servers.
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y

# Web UI on the Ethernet port (DHCP address and password, see the boot log).
CONFIG_WEB_UI_ENABLE=y

# Console: the USB-C port is the native USB-Serial-JTAG.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# microSD slot in SPI mode: SCK GPIO7, MOSI GPIO6, MISO GPIO5, CS GPIO4.
CONFIG_SD_CARD_SPI_MODE=y
CONFIG_SD_CARD_CLK_GPIO=7
CONFIG_SD_CARD_CMD_GPIO=6
CONFIG_SD_CARD_D0_GPIO=5
CONFIG_SD_CARD_CS_GPIO=4

# Download photos, then videos (as raw H.264 and AAC streams), to the SD card
# after the thumbnails.
CONFIG_CAMERA_DOWNLOAD_PHOTOS=y
CONFIG_CAMERA_DOWNLOAD_VIDEOS=y

# Taken from the T-Dongle-C5, which also has PSRAM and runs BLE, the camera
# Wi-Fi and the web UI; see sdkconfig.defaults.tdongle-c5 for the reasons.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_TASK_WDT_PANIC=y

# The thumbnails are on the SD card; no Base64 copy in the log.
# CONFIG_CAMERA_THUMBNAIL_SERIAL_PREVIEW is not set

# NimBLE's own INFO lines add little to the camera_ble log.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
