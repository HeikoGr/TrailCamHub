{
  "name": "trailcamhub-backend",
  "private": true,
  "version": "0.1.0",
  "description": "TrailCamHub backend: AWS Lambda + DynamoDB + S3, deployed with AWS SAM",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "register-hub": "node scripts/register-hub.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.850.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/client-ssm": "^3.850.0",
    "@aws-sdk/lib-dynamodb": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^22.16.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
